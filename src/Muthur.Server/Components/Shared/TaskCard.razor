<a class="card @(Task.Priority > 0 ? "card-priority" : "")" href="/tasks/@Task.Id">
    <div class="card-title"><span class="card-id">@Task.Id</span> @Task.Title</div>
    <div class="card-meta">
        @if (Task.Priority > 0)
        {
            <span class="pill pill-priority">priority</span>
        }
        @if (ShowProject)
        {
            <span class="pill">@Task.Project</span>
        }
        @if (Task.Owner is not null)
        {
            <span class="pill pill-owner"><span class="dot"></span>@Task.Owner</span>
        }
        @if (Task.State == TaskState.Blocked)
        {
            <span class="pill pill-blocked">waiting on founder</span>
        }
        @if (Task.AttendedReason is not null)
        {
            <span class="pill pill-blocked">needs a human</span>
        }
        @* Who and how long, not just that: "this task has a hold" tells the next lander nothing they can weigh. *@
        @if (Task.HoldExpires is { } until && until > Now && Task.HoldBy is { } by)
        {
            <span class="pill pill-blocked">held by @by · @Format.Age(until.AddMinutes(-HoldMinutes), Now)</span>
        }
        @foreach (var v in Task.Validations)
        {
            <span class="pill pill-verdict-@v.Verdict">@v.Validator @(v.Verdict == "pending" ? "···" : v.Verdict)</span>
        }
        <span class="card-age">@Format.Age(Task.UpdatedAt, Now)</span>
    </div>
</a>

@code {
    [Parameter, EditorRequired] public TaskDto Task { get; set; } = default!;
    [Parameter] public DateTimeOffset Now { get; set; }
    /// <summary>The hold window, so the card can say when a hold was placed from when it expires.</summary>
    [Parameter] public int HoldMinutes { get; set; } = 120;
    [Parameter] public bool ShowProject { get; set; }
}
