@page "/tasks/{Id}"
@inherits LivePanel
@inject TaskService Tasks
@inject TimeProvider Clock
@inject MuthurOptions Options

<PageTitle>MUTHUR · @Id</PageTitle>

@if (_detail is { } detail)
{
    var task = detail.Task;
    <div class="page">
        <section class="panel panel-fit">
            <div class="panel-body">
                <div class="detail-head">
                    <span class="card-id">@task.Id</span>
                    <h1 class="detail-title">@task.Title</h1>
                    <span class="pill pill-owner">@task.State.ToWire()</span>
                    @if (task.Priority > 0)
                    {
                        <span class="pill pill-priority">priority @task.Priority</span>
                    }
                    @foreach (var v in task.Validations)
                    {
                        <span class="pill pill-verdict-@v.Verdict">@v.Validator @v.Verdict</span>
                    }
                </div>
                <dl class="kv" style="margin-top: 12px">
                    <dt>Project</dt><dd>@task.Project</dd>
                    <dt>Validation provenance</dt><dd>@task.ProvenanceStatus</dd>
                    @if (task.CurrentSubject is { } subject)
                    {
                        <dt>Validation round</dt><dd>@subject.Id</dd>
                        <dt>Implementation SHA</dt><dd>@subject.ImplementationSha</dd>
                        <dt>Spec SHA-256</dt><dd>@subject.SpecSha256</dd>
                    }
                    @foreach (var validation in task.Validations)
                    {
                        <dt>@validation.Validator evidence</dt><dd>@validation.EvidenceStatus</dd>
                    }
                    @if (task.ProvenanceStatus != "current")
                    {
                        <dt>Recovery</dt><dd>@Validations.Recovery</dd>
                    }
                    @if (task.DependsOn is { Count: > 0 })
                    {
                        <dt>Prerequisites</dt><dd>@string.Join(", ", task.DependsOn) — @task.DependencyReason</dd>
                    }
                    <dt>Owner</dt>
                    <dd>
                        @(task.Owner ?? "—")@(task.ClaimExpires is { } lease ? " · lease " + Format.Until(lease, _now) : "")
                    </dd>
                    @if (task.SpecPath is { } spec)
                    {
                        <dt>Spec</dt><dd>@spec</dd>
                    }
                    @if (task.Branch is { } branch)
                    {
                        <dt>Branch</dt><dd>@branch</dd>
                    }
                    @if (task.PrUrl is { } pr)
                    {
                        <dt>Pull request</dt><dd><a href="@pr">@pr</a></dd>
                    }
                    @if (task.AttendedReason is { } attended)
                    {
                        <dt>Needs a human</dt><dd>@attended</dd>
                    }
                    @* The detail page, not only the card: the board's cards render inside a Virtualize, which
                       emits nothing to a fetch, and a lander deciding whether to override a hold is reading
                       this page. Who, when and why verbatim - "there is a hold" is not weighable. *@
                    @if (task.HoldExpires is { } until && until > _now && task.HoldBy is { } by)
                    {
                        <dt>Held</dt>
                        <dd>by @by, @Format.Age(until.AddMinutes(-HoldMinutes), _now) ago: @task.HoldReason</dd>
                    }
                    @if (task.Parent is { } parent)
                    {
                        <dt>Parent</dt><dd><a href="/tasks/@parent">@parent</a></dd>
                    }
                    <dt>Created</dt><dd>@Stamp(task.CreatedAt)</dd>
                    <dt>Updated</dt><dd>@Stamp(task.UpdatedAt)</dd>
                    @if (task.DoneAt is { } doneAt)
                    {
                        <dt>Done</dt><dd>@Stamp(doneAt)</dd>
                    }
                </dl>
            </div>
        </section>
        <section class="panel panel-fit">
            <div class="panel-head"><span class="panel-title">Description</span></div>
            <div class="panel-body">
                @if (string.IsNullOrWhiteSpace(task.Body))
                {
                    <div class="empty">no description</div>
                }
                else
                {
                    <div class="prose">@task.Body</div>
                }
            </div>
        </section>
        <section class="panel">
            <div class="panel-head">
                <span class="panel-title">History</span>
                <span class="panel-sub">@detail.Events.Count events</span>
            </div>
            <div class="panel-body">
                @foreach (var e in detail.Events)
                {
                    <EventRow Event="e" Now="_now" ShowTask="false" />
                }
            </div>
        </section>
    </div>
}
else if (_error is { } message)
{
    <div class="page">
        <section class="panel panel-fit">
            <div class="panel-body"><div class="empty">@message</div></div>
        </section>
    </div>
}

@code {
    private TaskDetailDto? _detail;
    private string? _error;
    private string? _loadedId;
    private DateTimeOffset _now;
    private int HoldMinutes => Options.HoldMinutes;

    [Parameter] public string Id { get; set; } = "";

    // Lease wording and event ages change with time alone.
    protected override TimeSpan? ClockInterval => TimeSpan.FromSeconds(30);

    protected override bool IsRelevant(Muthur.Core.Entities.LedgerEvent e) =>
        Wire.TryParseTaskId(Id, out var number) && e.TaskId == number;

    protected override async Task LoadAsync()
    {
        _now = Clock.GetUtcNow();
        _loadedId = Id;
        try
        {
            _detail = await Tasks.GetAsync(Id);
            _error = null;
        }
        catch (Muthur.Core.MuthurException ex)
        {
            _detail = null;
            _error = ex.Message;
        }
    }

    // Blazor reuses this component when navigating from one task to another.
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId is not null && _loadedId != Id) await ReloadNowAsync();
    }

    private static string Stamp(DateTimeOffset value) => value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
}
