@inherits LivePanel
@inject OverseerService Overseer
@using Muthur.Launch

<section class="panel">
    <div class="panel-head"><span class="panel-title">Overseer</span><span class="panel-sub">@(_status.Config.Enabled ? "enabled" : "off")</span></div>
    <div class="panel-body">
        <div class="agent-meta">@_status.Config.Harness / @_status.Config.Model · @_status.Config.ReasoningEffort</div>
        <div class="agent-meta">@_status.StartsToday / @_status.Config.MaxStartsPerDay starts in 24h · shares conductor slots</div>
        <div class="agent-meta">@(_status.Run is null ? _status.LastOutcome ?? "waiting for work" : "session running")</div>
        @if (_status.Summary.Length > 0) { <details><summary>Durable memory</summary><p class="prose">@_status.Summary</p></details> }
        @foreach (var wait in _status.Waits)
        {
            <div class="agent-meta">Waiting: @wait.Target @wait.Expected — @wait.Reason @(wait.Group.Length > 0 ? $"(all in {wait.Group})" : "")</div>
        }
        <button class="btn" @onclick="Edit">Configure</button>
        @if (_editing)
        {
            <div class="overseer-settings">
            <div><label>Enabled <input type="checkbox" @bind="_enabled" /></label></div>
            <div><label>Provider <select aria-label="Provider" @bind="_harness">@foreach (var provider in OverseerDefaults.Providers) { <option value="@provider.Key">@provider.Label</option> }</select></label></div>
            <div><label>Model ID <input @bind="_model" /></label></div>
            <div><label>Account key <input @bind="_account" /></label></div>
            <div><label>Effort <select aria-label="Effort" @bind="_effort">@foreach (var effort in new[] { "low", "medium", "high", "xhigh", "max" }) { <option value="@effort">@effort</option> }</select></label></div>
            <div><label>Minutes per session <input type="number" min="2" max="30" @bind="_minutes" /></label></div>
            <div><label>Starts per 24 hours <input type="number" min="1" max="100" @bind="_starts" /></label></div>
            <div><label>Cooldown minutes <input type="number" min="1" max="1440" @bind="_cooldown" /></label></div>
            <div><label>Starting context characters <input type="number" min="8000" max="64000" @bind="_context" /></label></div>
            <div><label>Memory characters <input type="number" min="1000" max="12000" @bind="_memory" /></label></div>
            <p>Changes apply to the next session. Disabling immediately removes decision authority. Pending conditions survive fresh sessions.</p>
            <button class="btn" @onclick="Save">Save overseer settings</button>
            <button class="btn" @onclick="() => _editing = false">Cancel</button>
            </div>
        }
        @if (_error is not null) { <div class="error-text">@_error</div> }
    </div>
</section>

@code {
    private OverseerStatus _status = new(new(), null, "", [], null, 0, null);
    private bool _editing, _enabled;
    private string _harness = OverseerDefaults.Harness, _model = OverseerDefaults.Model, _account = "", _effort = "medium";
    private int _minutes, _starts, _cooldown, _context, _memory;
    private string? _error;
    protected override bool IsRelevant(Muthur.Core.Entities.LedgerEvent e) => e.Type.StartsWith("overseer.", StringComparison.Ordinal);
    protected override async Task LoadAsync() => _status = await Overseer.StatusAsync();
    private void Edit()
    {
        var c = _status.Config;
        (_enabled, _harness, _model, _account, _effort) = (c.Enabled, c.Harness, c.Model, c.Account ?? "", c.ReasoningEffort);
        (_minutes, _starts, _cooldown, _context, _memory) = (c.SessionMinutes, c.MaxStartsPerDay, c.CooldownMinutes, c.ContextChars, c.MemoryChars);
        _editing = true;
    }
    private async Task Save()
    {
        try
        {
            _status = await Overseer.ConfigureAsync(Caller.Founder, new(_enabled, _harness, _model, _account, _effort,
                _minutes, _starts, _cooldown, _context, _memory));
            _editing = false; _error = null;
        }
        catch (Muthur.Core.MuthurException ex) { _error = ex.Message; }
    }
}
