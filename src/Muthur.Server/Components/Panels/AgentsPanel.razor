@inherits LivePanel
@inject AgentService Agents
@inject TaskService Tasks
@inject TimeProvider Clock

<section class="panel">
    <div class="panel-head">
        <span class="panel-title">Agents</span>
        @if (_hidden > 0)
        {
            <span class="panel-sub">@_live live of @_agents.Count · @_hidden conductor hidden</span>
        }
        else
        {
            <span class="panel-sub">@_live live of @_agents.Count</span>
        }
        <div class="filters">
            <button class="filter @Active(false)" @onclick="() => Select(false)">Standing</button>
            <button class="filter @Active(true)" @onclick="() => Select(true)">All</button>
        </div>
    </div>
    <div class="panel-body">
        @if (_agents.Count == 0 && _hidden > 0)
        {
            <div class="empty">@_hidden conductor sessions hidden · All shows them</div>
        }
        else if (_agents.Count == 0)
        {
            <div class="empty">no agents registered · muthur agent register --name …</div>
        }
        @foreach (var a in _agents)
        {
            var limitedUntil = a.Status == AgentStatus.Limited ? a.LimitedUntil : null;
            <div class="agent @Modifier(a.Status)">
                <div class="agent-head">
                    <span class="dot"></span>
                    <span class="agent-name">@a.Name</span>
                    @if (a.Tier is not null)
                    {
                        <span class="tag">@a.Tier</span>
                    }
                    <span class="agent-age">@Format.Age(a.LastHeartbeat, _now)</span>
                </div>
                <div class="agent-model">@a.Harness/@a.Model@(a.Account is not null ? " · " + a.Account : "")</div>
                @if (_working.TryGetValue(a.Name, out var working))
                {
                    <div class="agent-task">@working.Id · @working.Title</div>
                }
                @if (!string.IsNullOrWhiteSpace(a.Summary))
                {
                    <div class="agent-summary">@a.Summary</div>
                }
                @if (a.Roles.Count > 0 || a.OpenTasks > 0 || limitedUntil is not null)
                {
                    <div class="agent-meta">
                        @foreach (var role in a.Roles)
                        {
                            <span class="pill pill-role">@role</span>
                        }
                        @if (a.OpenTasks > 0)
                        {
                            <span class="pill">@a.OpenTasks @(a.OpenTasks == 1 ? "task" : "tasks")</span>
                        }
                        @if (limitedUntil is { } until)
                        {
                            <span class="pill pill-blocked">limited @Format.Until(until, _now)</span>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private List<AgentDto> _agents = [];
    // The one task each agent is actually working on. OpenTasks counts everything they hold, validation included.
    private Dictionary<string, TaskDto> _working = new(StringComparer.Ordinal);
    private int _live;
    // Conductor-staffed sessions the roster left out. Shown as a number rather than implied by a shorter list:
    // a rail that quietly drops rows reads exactly like a quiet organization.
    private int _hidden;
    private bool _all;
    private DateTimeOffset _now;

    // An agent goes stale without anything being written, so refresh on the clock too.
    protected override TimeSpan? ClockInterval => TimeSpan.FromSeconds(15);

    protected override bool IsRelevant(Muthur.Core.Entities.LedgerEvent e) =>
        e.Type.StartsWith("agent.", StringComparison.Ordinal)
        || e.Type.StartsWith("role.", StringComparison.Ordinal)
        || e.Type.StartsWith("task.", StringComparison.Ordinal);

    protected override async Task LoadAsync()
    {
        _now = Clock.GetUtcNow();
        var roster = await Agents.RosterAsync(_all);
        var agents = roster.Agents;
        _hidden = roster.ConductorHidden;
        _agents = agents.OrderBy(a => Rank(a.Status)).ThenBy(a => a.Name, StringComparer.Ordinal).ToList();
        _live = agents.Count(a => a.Status == AgentStatus.Live);

        // Only InProgress: a task in validating is owned but handed away, not being worked on.
        var open = await Tasks.ListAsync(new TaskQuery(OpenOnly: true, Limit: 2000));
        _working = open
            .Where(t => t.Owner is not null && t.State == TaskState.InProgress)
            .GroupBy(t => t.Owner!, StringComparer.Ordinal)
            .ToDictionary(
                g => g.Key,
                g => g.OrderByDescending(t => t.Priority).ThenBy(t => t.Id, StringComparer.Ordinal).First(),
                StringComparer.Ordinal);
    }

    // The filter is a different read, not a different slice of one already in hand, so it re-runs the load.
    private Task Select(bool all)
    {
        _all = all;
        return ReloadNowAsync();
    }

    private string Active(bool all) => _all == all ? "active" : "";

    private static int Rank(AgentStatus status) => status switch
    {
        AgentStatus.Live => 0,
        AgentStatus.Limited => 1,
        _ => 2,
    };

    private static string Modifier(AgentStatus status) => status switch
    {
        AgentStatus.Stale => "agent-stale",
        AgentStatus.Limited => "agent-limited",
        _ => "",
    };
}
