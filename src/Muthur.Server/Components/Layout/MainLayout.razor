@inherits LayoutComponentBase

<div class="shell">
    <header class="topbar">
        <a class="brand" href="/">MU/TH/UR <span class="brand-sub">HUB</span></a>
        <nav class="tabs">
            <NavLink href="/" Match="NavLinkMatch.All">Board</NavLink>
            <NavLink href="/needs-you">Needs you<NeedsYouBadge /></NavLink>
            <NavLink href="/stream">Stream</NavLink>
            <NavLink href="/operations">Operations</NavLink>
            @* No badge: a badge here means something needs the founder, and receipts never needs anyone. *@
            <NavLink href="/receipts">Receipts</NavLink>
            <NavLink href="/projects">Projects</NavLink>
            @* No badge: the console is where the founder goes to act, never a place that is waiting on them. *@
            <NavLink href="/console">Console</NavLink>
        </nav>
        <HeaderStats />
    </header>
    <main class="content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Connection to the hub was interrupted.
    <a href="." class="reload">Reload</a>
</div>
